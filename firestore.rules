rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if false;
      match /{collection}/{id} {
        allow read: if owner(uid) && collection in ['collection', 'album', 'packs', 'dailyExploration', 'rewards', 'progress', 'attempts', 'adTickets'];
        allow write: if false;
      }
      // Economy history is server-only. The client receives its balance from
      // the authoritative user view and cannot enumerate audit metadata.
      match /economyTransactions/{transactionId} {
        allow read, write: if false;
      }
    }
    match /profiles/{uid} { allow read: if owner(uid); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
